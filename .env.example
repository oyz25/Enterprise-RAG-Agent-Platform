# Database & Vector Store
DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@postgres:5432/rag_db
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# LLM Synthesis (Optional - falls back to deterministic citation grounding if unreachable)
LLM_ENABLED=true
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2

# Security & Rate Limiting
API_SECRET_KEY=
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Frontend Public API Endpoint
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_KEY=